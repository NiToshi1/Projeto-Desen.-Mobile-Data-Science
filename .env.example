# Opcional. Copie para .env e reinicie o Expo depois de mudar.
#
# Por padrão o app usa o IP do computador que serve o Expo + porta 3333.
# Só preencha se precisar apontar para outro endereço (IP fixo, API em outra máquina...).
# EXPO_PUBLIC_API_URL=http://192.168.0.10:3333
#
# Se a API foi iniciada com API_TOKEN (veja api/.env.example), use o mesmo valor aqui:
# EXPO_PUBLIC_API_KEY=
