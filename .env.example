# Copie este arquivo para .env e preencha a chave. Reinicie o Expo depois de mudar.

# --- Banco de dados (Supabase) ---
# Supabase > Project Settings > API Keys: copie a chave "anon" (ou "sb_publishable_...").
# Use SOMENTE a chave pública. NUNCA coloque a service_role ou a senha do banco aqui.
EXPO_PUBLIC_SUPABASE_URL=https://qnekfrobiamvwgxhkdai.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- API Express (só o indicador territorial de Data Science) ---
# Opcional. Por padrão o app usa o IP do computador que serve o Expo + porta 3333.
# EXPO_PUBLIC_API_URL=http://192.168.0.10:3333
